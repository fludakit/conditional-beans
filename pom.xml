<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fludakit</groupId>
        <artifactId>fludakit-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>fluda-conditional-beans-parent</artifactId>
    <packaging>pom</packaging>

    <name>FluDa :: Conditional Beans</name>
    <description>Portable CDI Extension providing declarative conditional bean activation for CDI 4.1.</description>
    <url>https://github.com/fludakit/conditional-beans</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Hantsy Bai</name>
            <email>hantsy@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/fludakit/conditional-beans.git</connection>
        <developerConnection>scm:git:ssh://github.com:fludakit/conditional-beans.git</developerConnection>
        <url>https://github.com/fludakit/conditional-beans</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- The Quarkus version the CDI Lite path is verified against. -->
        <quarkus.version>3.39.1</quarkus.version>
    </properties>

    <modules>
        <module>api</module>
        <module>full</module>
        <module>lite</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-conditional-beans-api</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-conditional-beans-full</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-conditional-beans-lite</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/fludakit/conditional-beans</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <name>GitHub Packages - Fludakit Org</name>
            <id>github-fludakit</id>
            <url>https://maven.pkg.github.com/fludakit/*</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
